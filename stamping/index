<script>
// ==================== 板材价格库 ====================
let stampingMaterialsData = [
    { id: "hr1", MaterialCode: "Q235A", Type: "热轧", Spec: "1.5-6.0mm", Thickness: 3.0, Density: 7.85, UnitPrice: 3.5 },
    { id: "hr2", MaterialCode: "510L", Type: "热轧", Spec: "2.0-8.0mm", Thickness: 4.0, Density: 7.85, UnitPrice: 5.0 },
    { id: "hr3", MaterialCode: "QSTE500TM", Type: "热轧", Spec: "1.5-20mm", Thickness: 3.0, Density: 7.85, UnitPrice: 5.4 },
    { id: "cr1", MaterialCode: "DC01", Type: "冷轧", Spec: "0.5-3.0mm", Thickness: 1.0, Density: 7.85, UnitPrice: 5.8 },
    { id: "cr2", MaterialCode: "DC03", Type: "冷轧", Spec: "0.5-2.5mm", Thickness: 0.8, Density: 7.85, UnitPrice: 6.2 },
    { id: "hs1", MaterialCode: "HC340/590DP", Type: "高强钢", Spec: "0.8-2.5mm", Thickness: 1.2, Density: 7.85, UnitPrice: 7.5 },
    { id: "ga1", MaterialCode: "DX51D+Z", Type: "镀锌", Spec: "0.4-3.0mm", Thickness: 0.8, Density: 7.85, UnitPrice: 6.2 }
];

let weldPriceData = [
    { id: "w1", WeldType: "spot", DisplayName: "点焊", Unit: "元/点", DefaultPrice: 0.25 },
    { id: "w2", WeldType: "mig", DisplayName: "二保焊", Unit: "元/cm", DefaultPrice: 0.10 },
    { id: "w3", WeldType: "tig", DisplayName: "氩弧焊", Unit: "元/cm", DefaultPrice: 0.18 },
    { id: "w4", WeldType: "laser", DisplayName: "激光焊", Unit: "元/cm", DefaultPrice: 0.45 },
    { id: "w5", WeldType: "projection", DisplayName: "凸焊", Unit: "元/个", DefaultPrice: 0.30 },
    { id: "w6", WeldType: "robot", DisplayName: "机器人焊接", Unit: "元/小时", DefaultPrice: 180 }
];

let bomItems = [];
let feedbackList = [];
let historyList = [];
let chartInstance = null;
let currentPartWeightG = 0;
let currentMaterialCost = 0;

// ==================== 存储函数 ====================
function loadFromStorage() {
    let m = localStorage.getItem('stamping_materials'); if (m) stampingMaterialsData = JSON.parse(m);
    let w = localStorage.getItem('stamping_weld'); if (w) weldPriceData = JSON.parse(w);
    let b = localStorage.getItem('stamping_bom'); if (b) bomItems = JSON.parse(b);
    let f = localStorage.getItem('stamping_feedback'); if (f) feedbackList = JSON.parse(f);
    let h = localStorage.getItem('stamping_history'); if (h) historyList = JSON.parse(h);
}
function saveMaterials() { localStorage.setItem('stamping_materials', JSON.stringify(stampingMaterialsData)); }
function saveWeldData() { localStorage.setItem('stamping_weld', JSON.stringify(weldPriceData)); }
function saveBomData() { localStorage.setItem('stamping_bom', JSON.stringify(bomItems)); }
function saveFeedback() { localStorage.setItem('stamping_feedback', JSON.stringify(feedbackList)); }
function saveHistory() { localStorage.setItem('stamping_history', JSON.stringify(historyList.slice(0, 10))); }

// ==================== UI刷新 ====================
function refreshSelects() {
    let matSelect = document.getElementById('materialSelect');
    if (matSelect && stampingMaterialsData.length > 0) {
        let currentVal = matSelect.value;
        matSelect.innerHTML = '';
        stampingMaterialsData.forEach(m => { let opt = new Option(`${m.MaterialCode} (${m.Type})`, m.id); matSelect.appendChild(opt); });
        if (currentVal && stampingMaterialsData.some(m => m.id === currentVal)) matSelect.value = currentVal;
        else matSelect.value = stampingMaterialsData[0]?.id;
        updateMaterialInfo();
    }
    refreshNewPartMaterialSelect();
    renderBomTable();
}

function updateMaterialInfo() {
    let materialId = document.getElementById('materialSelect').value;
    let material = stampingMaterialsData.find(m => m.id === materialId);
    if (material) {
        document.getElementById('materialPrice').value = material.UnitPrice;
        document.getElementById('materialThickness').value = material.Thickness;
    }
}

function refreshPreviewTables() {
    let matBody = document.getElementById('materialPreviewBody');
    if (matBody) {
        matBody.innerHTML = '';
        stampingMaterialsData.forEach(m => { let row = matBody.insertRow(); row.insertCell(0).innerHTML = m.MaterialCode; row.insertCell(1).innerHTML = m.Type; row.insertCell(2).innerHTML = m.Spec; row.insertCell(3).innerHTML = m.UnitPrice; });
    }
    let weldBody = document.getElementById('weldPreviewBody');
    if (weldBody) {
        weldBody.innerHTML = '';
        weldPriceData.forEach(w => { let row = weldBody.insertRow(); row.insertCell(0).innerHTML = w.DisplayName; row.insertCell(1).innerHTML = w.Unit; row.insertCell(2).innerHTML = w.DefaultPrice; });
    }
}

function refreshNewPartMaterialSelect() {
    let select = document.getElementById('newPartMaterial');
    if (select && stampingMaterialsData.length > 0) {
        select.innerHTML = '';
        stampingMaterialsData.forEach(m => {
            select.innerHTML += `<option value="${m.MaterialCode}">${m.MaterialCode} (${m.Type})</option>`;
        });
    }
}

// ==================== BOM表计算 ====================
function calculatePartMetrics(item) {
    let material = stampingMaterialsData.find(m => m.MaterialCode === item.materialCode);
    let density = material ? material.Density : 7.85;
    let blankAreaCm2 = (item.length * item.width) / 100;
    let utilization = item.utilization || 75;
    let partWeight = blankAreaCm2 * (item.thickness / 10) * density * (utilization / 100);
    let totalWeight = partWeight * item.qty;
    return { blankArea: blankAreaCm2, partWeight: partWeight, totalWeight: totalWeight };
}

function calculateBomTotal() {
    let totalWeight = 0;
    let totalMaterialCost = 0;
    let totalPartCount = 0;
    let totalUtilization = 0;
    bomItems.forEach(item => {
        let material = stampingMaterialsData.find(m => m.MaterialCode === item.materialCode);
        let materialPrice = material ? material.UnitPrice : 5.8;
        let metrics = calculatePartMetrics(item);
        totalWeight += metrics.totalWeight;
        totalMaterialCost += (metrics.totalWeight / 1000) * materialPrice;
        totalPartCount += item.qty;
        totalUtilization += item.utilization || 75;
    });
    return { totalWeight, totalMaterialCost, totalPartCount, avgUtilization: bomItems.length ? totalUtilization / bomItems.length : 0 };
}

function renderMaterialOptions(selectedCode) {
    if (!stampingMaterialsData || stampingMaterialsData.length === 0) {
        return '<option value="">暂无材料，请先添加</option>';
    }
    let options = '';
    stampingMaterialsData.forEach(m => {
        let selected = (m.MaterialCode === selectedCode) ? 'selected' : '';
        options += `<option value="${m.MaterialCode}" ${selected}>${m.MaterialCode} (${m.Type})</option>`;
    });
    return options;
}

function renderBomTable() {
    let tbody = document.getElementById('bomTableBody');
    if (!tbody) return;
    tbody.innerHTML = '';
    
    if (bomItems.length === 0) {
        let row = tbody.insertRow();
        let cell = row.insertCell(0);
        cell.colSpan = 11;
        cell.innerHTML = '<div style="padding: 20px; text-align: center; color: #94a3b8;">暂无子零件，请点击"+ 添加"按钮添加</div>';
        cell.style.textAlign = 'center';
    } else {
        bomItems.forEach((item, idx) => {
            let metrics = calculatePartMetrics(item);
            let row = tbody.insertRow();
            
            // 零件名称
            let cell0 = row.insertCell(0);
            cell0.innerHTML = `<input type="text" value="${escapeHtml(item.partName)}" class="bom-name-${idx}" style="width:95%; padding:4px;">`;
            cell0.style.minWidth = '100px';
            
            // 数量
            let cell1 = row.insertCell(1);
            cell1.innerHTML = `<input type="number" value="${item.qty}" class="bom-qty-${idx}" step="1" style="width:60px; padding:4px; text-align:center;">`;
            cell1.style.minWidth = '60px';
            
            // 材料牌号
            let cell2 = row.insertCell(2);
            cell2.innerHTML = `<select class="bom-material-${idx}" style="width:130px; padding:4px;">${renderMaterialOptions(item.materialCode)}</select>`;
            cell2.style.minWidth = '140px';
            
            // 厚度
            let cell3 = row.insertCell(3);
            cell3.innerHTML = `<input type="number" value="${item.thickness}" class="bom-thickness-${idx}" step="0.1" style="width:70px; padding:4px; text-align:center;">`;
            cell3.style.minWidth = '70px';
            
            // 长
            let cell4 = row.insertCell(4);
            cell4.innerHTML = `<input type="number" value="${item.length}" class="bom-length-${idx}" step="10" style="width:80px; padding:4px; text-align:center;">`;
            cell4.style.minWidth = '80px';
            
            // 宽
            let cell5 = row.insertCell(5);
            cell5.innerHTML = `<input type="number" value="${item.width}" class="bom-width-${idx}" step="10" style="width:80px; padding:4px; text-align:center;">`;
            cell5.style.minWidth = '80px';
            
            // 展开面积
            let cell6 = row.insertCell(6);
            cell6.innerHTML = `<span style="display:inline-block; width:100%; text-align:center;">${metrics.blankArea.toFixed(1)}</span>`;
            cell6.style.minWidth = '90px';
            
            // 利用率
            let cell7 = row.insertCell(7);
            cell7.innerHTML = `<input type="number" value="${item.utilization || 75}" class="bom-util-${idx}" step="5" style="width:80px; padding:4px; text-align:center;">`;
            cell7.style.minWidth = '80px';
            
            // 单件重量
            let cell8 = row.insertCell(8);
            cell8.innerHTML = `<span style="display:inline-block; width:100%; text-align:center;">${metrics.partWeight.toFixed(1)}</span>`;
            cell8.style.minWidth = '90px';
            
            // 总重量
            let cell9 = row.insertCell(9);
            cell9.innerHTML = `<span style="display:inline-block; width:100%; text-align:center; font-weight:600;">${metrics.totalWeight.toFixed(1)}</span>`;
            cell9.style.minWidth = '90px';
            
            // 操作
            let cell10 = row.insertCell(10);
            cell10.innerHTML = `<span class="edit-icon" data-idx="${idx}" data-type="bom" style="cursor:pointer;">💾</span> <span class="delete-icon" data-idx="${idx}" data-type="bom" style="cursor:pointer;">🗑️</span>`;
            cell10.style.minWidth = '70px';
        });
    }
    
    attachBomEvents();
    updateBomSummary();
}

function updateBomSummary() {
    let bomTotal = calculateBomTotal();
    document.getElementById('totalPartCount').innerText = bomTotal.totalPartCount;
    document.getElementById('totalBomWeight').innerHTML = `${bomTotal.totalWeight.toFixed(1)} g`;
    document.getElementById('avgUtilization').innerHTML = `${bomTotal.avgUtilization.toFixed(1)}%`;
    document.getElementById('totalBomMaterialCost').innerHTML = `${bomTotal.totalMaterialCost.toFixed(2)} 元`;
}

function attachBomEvents() {
    document.querySelectorAll('#bomTableBody .edit-icon').forEach(el => {
        el.onclick = () => {
            let idx = parseInt(el.dataset.idx);
            let newName = document.querySelector(`.bom-name-${idx}`)?.value;
            let newQty = parseInt(document.querySelector(`.bom-qty-${idx}`)?.value);
            let newMaterial = document.querySelector(`.bom-material-${idx}`)?.value;
            let newThickness = parseFloat(document.querySelector(`.bom-thickness-${idx}`)?.value);
            let newLength = parseFloat(document.querySelector(`.bom-length-${idx}`)?.value);
            let newWidth = parseFloat(document.querySelector(`.bom-width-${idx}`)?.value);
            let newUtil = parseFloat(document.querySelector(`.bom-util-${idx}`)?.value);
            if (newName) bomItems[idx].partName = newName;
            if (!isNaN(newQty)) bomItems[idx].qty = newQty;
            if (newMaterial) bomItems[idx].materialCode = newMaterial;
            if (!isNaN(newThickness)) bomItems[idx].thickness = newThickness;
            if (!isNaN(newLength)) bomItems[idx].length = newLength;
            if (!isNaN(newWidth)) bomItems[idx].width = newWidth;
            if (!isNaN(newUtil)) bomItems[idx].utilization = newUtil;
            saveBomData(); renderBomTable(); calculate();
            showToast('BOM已保存');
        };
    });
    document.querySelectorAll('#bomTableBody .delete-icon').forEach(el => {
        el.onclick = () => { if (confirm('确认删除？')) { bomItems.splice(parseInt(el.dataset.idx), 1); saveBomData(); renderBomTable(); calculate(); showToast('已删除'); } };
    });
}

// ==================== 焊接单价获取 ====================
function getWeldRate(weldType) { let w = weldPriceData.find(w => w.WeldType === weldType); return w ? w.DefaultPrice : 0.25; }
function getWeldUnit(weldType) { let w = weldPriceData.find(w => w.WeldType === weldType); return w ? w.Unit : '元/点'; }

// ==================== 核心成本计算 ====================
function calculatePartWeightAndCost() {
    let method = document.getElementById('weightMethod').value;
    let scrapRate = parseFloat(document.getElementById('scrapRate').value) || 0;
    let materialId = document.getElementById('materialSelect').value;
    let material = stampingMaterialsData.find(m => m.id === materialId);
    let density = material ? material.Density : 7.85;
    let materialPrice = material ? material.UnitPrice : 5.8;
    let detail = [];
    
    if (method === 'netWeight') {
        let partWeight = parseFloat(document.getElementById('partNetWeight').value) || 0;
        let materialWeight = partWeight * (1 + scrapRate / 100);
        let materialCost = (materialWeight / 1000) * materialPrice;
        detail.push(`净重模式: ${partWeight.toFixed(1)} g`);
        return { partWeight, materialWeight, materialCost, detail, method: 'netWeight' };
    } 
    else if (method === 'blankArea') {
        let blankArea = parseFloat(document.getElementById('blankArea').value) || 0;
        let utilization = parseFloat(document.getElementById('materialUtilization').value) || 65;
        let thickness = material?.Thickness || 1.0;
        let blankWeight = blankArea * (thickness / 10) * density;
        let partWeight = blankWeight * (utilization / 100);
        let materialWeight = blankWeight * (1 + scrapRate / 100);
        let materialCost = (materialWeight / 1000) * materialPrice;
        detail.push(`展开面积模式: ${blankArea} cm², 厚度${thickness}mm, 利用率${utilization}%`);
        return { partWeight, materialWeight, materialCost, detail, method: 'blankArea' };
    } 
    else {
        let bomTotal = calculateBomTotal();
        let partWeight = bomTotal.totalWeight;
        let materialWeight = partWeight * (1 + scrapRate / 100);
        let materialCost = bomTotal.totalMaterialCost * (1 + scrapRate / 100);
        detail.push(`BOM模式: ${bomItems.length}种子零件, 总重${partWeight.toFixed(1)}g`);
        return { partWeight, materialWeight, materialCost, detail, method: 'bom' };
    }
}

function calculateDieCost(annualQty, projAreaCm2) {
    let dieType = document.getElementById('dieType').value;
    let dieLife = parseFloat(document.getElementById('dieLife').value) || 50;
    let processCount = parseInt(document.getElementById('processCount').value) || 1;
    let complexity = parseFloat(document.getElementById('dieComplexity').value) || 1.3;
    let payment = document.getElementById('diePayment').value;
    let supplierRatio = payment === 'full_automaker' ? 0 : (payment === 'partial' ? (parseFloat(document.getElementById('partialRatio').value) || 0) / 100 : 1);
    let basePrice = { single: 50000, compound: 80000, progressive: 120000, transfer: 200000 }[dieType] || 80000;
    let areaFactor = Math.max(0.5, Math.min(2, projAreaCm2 / 1000));
    let processFactor = 1 + (processCount - 1) * 0.15;
    let lifeFactor = dieLife / 50;
    let totalPrice = basePrice * complexity * areaFactor * processFactor * Math.pow(lifeFactor, 0.6);
    let perPart = (totalPrice * supplierRatio) / annualQty;
    return { totalPrice, perPart };
}

function calculatePressCost() {
    let pressTonnage = document.getElementById('pressTonnage').value;
    if (pressTonnage === 'custom') pressTonnage = parseFloat(document.getElementById('customPressTonnage').value) || 400;
    else pressTonnage = parseFloat(pressTonnage);
    let spm = parseFloat(document.getElementById('strokePerMinute').value) || 35;
    let equipRate = parseFloat(document.getElementById('equipmentRate').value) || 120;
    let laborRate = parseFloat(document.getElementById('laborRate').value) || 38;
    let changeover = parseFloat(document.getElementById('changeoverTime').value) || 30;
    let batch = parseFloat(document.getElementById('batchSize').value) || 5000;
    let cycleSec = 60 / spm;
    let changeoverPerPart = (changeover * 60) / batch;
    let totalSec = cycleSec + changeoverPerPart;
    let cost = (equipRate + laborRate) / 3600 * totalSec;
    return { cost, tonnage: pressTonnage, spm, cycleSec };
}

function calculateWeldCost() {
    let type = document.getElementById('weldType').value;
    if (type === 'none') return 0;
    let rate = getWeldRate(type);
    if (type === 'spot') { let cnt = parseFloat(document.getElementById('weldSpotCount').value) || 0; return cnt * rate; }
    if (type === 'mig' || type === 'tig' || type === 'laser') { let len = parseFloat(document.getElementById('weldLength').value) || 0; return (len / 10) * rate; }
    if (type === 'projection') { let cnt = parseFloat(document.getElementById('weldSpotCount').value) || 0; return cnt * rate; }
    if (type === 'robot') { let sec = parseFloat(document.getElementById('robotWeldTime').value) || 0; return (sec / 3600) * rate; }
    return 0;
}

function calculateGaugeCost(annualQty) {
    if (document.getElementById('needGauge').value !== 'yes') return 0;
    let type = document.getElementById('gaugeType').value;
    let price = type === 'simple' ? 1500 : type === 'standard' ? 5000 : type === 'complex' ? 15000 : parseFloat(document.getElementById('customGaugePrice').value) || 0;
    let life = parseFloat(document.getElementById('gaugeLife').value) || 3;
    return price / life / annualQty;
}

function calculateSurfaceCost(projAreaCm2) {
    let process = document.getElementById('surfaceProcess').value;
    if (process === 'none') return 0;
    let price = parseFloat(document.getElementById('surfacePrice').value) || 0;
    let area = parseFloat(document.getElementById('surfaceArea').value) || 0;
    if (area <= 0) area = (projAreaCm2 * 2.5) / 100;
    return area * price;
}

function calculateLogisticsCost(partWeightG) {
    let distance = parseFloat(document.getElementById('logisticsDistance').value) || 500;
    let rate = parseFloat(document.getElementById('ratePerTonKm').value) || 0.5;
    let minFreight = parseFloat(document.getElementById('minFreight').value) || 300;
    let fullLoad = parseInt(document.getElementById('fullLoadQty').value) || 8000;
    let handling = parseFloat(document.getElementById('handlingFee').value) || 0.5;
    let weightKg = partWeightG / 1000;
    let theoretical = rate * weightKg * distance;
    let actual = Math.max(theoretical, minFreight);
    return actual / fullLoad + handling;
}

// ==================== 核心计算 ====================
function calculate() {
    try {
        let annualQty = parseInt(document.getElementById('annualQty').value) || 100000;
        let length = parseFloat(document.getElementById('length')?.value) || 800;
        let width = parseFloat(document.getElementById('width')?.value) || 500;
        let projAreaCm2 = (length * width) / 100;
        
        let weightResult = calculatePartWeightAndCost();
        let partWeightG = weightResult.partWeight;
        currentPartWeightG = partWeightG;
        let materialCost = weightResult.materialCost;
        currentMaterialCost = materialCost;
        
        // 废料回收扣减
        let scrapPrice = parseFloat(document.getElementById('scrapPrice').value) || 2.0;
        let scrapMethod = document.getElementById('scrapAccountingMethod').value;
        let scrapValue = (weightResult.materialWeight / 1000) * scrapPrice;
        if (scrapMethod === 'deduct') materialCost = Math.max(0, materialCost - scrapValue);
        
        let dieResult = calculateDieCost(annualQty, projAreaCm2);
        let pressResult = calculatePressCost();
        let weldCost = calculateWeldCost();
        let gaugeCost = calculateGaugeCost(annualQty);
        let surfaceCost = calculateSurfaceCost(projAreaCm2);
        let logisticsCost = calculateLogisticsCost(partWeightG);
        let fixtureCost = parseFloat(document.getElementById('weldFixtureCost').value) || 0;
        let totalWeldCost = weldCost + fixtureCost;
        
        let directCost = materialCost + pressResult.cost + dieResult.perPart + totalWeldCost + gaugeCost + surfaceCost + logisticsCost;
        let managementCost = directCost * 0.12;
        let profit = (directCost + managementCost) * 0.10;
        let totalCost = directCost + managementCost + profit;
        let quotePrice = totalCost * 1.13;
        
        // 更新UI
        document.getElementById('totalCostVal').innerHTML = totalCost.toFixed(2) + ' 元';
        document.getElementById('quotePriceVal').innerHTML = quotePrice.toFixed(2) + ' 元';
        document.getElementById('weightDetail').innerHTML = `⚖️ ${weightResult.detail.join(' | ')} | 材料费: ${materialCost.toFixed(2)}元`;
        document.getElementById('logisticsDetail').innerHTML = `🚚 单件物流费: ${logisticsCost.toFixed(3)}元`;
        document.getElementById('dieCostDetail').innerHTML = `💰 模具总价: ${Math.round(dieResult.totalPrice).toLocaleString()}元 | 单件分摊: ${dieResult.perPart.toFixed(3)}元`;
        document.getElementById('equipAdvice').innerHTML = `推荐设备: ${pressResult.tonnage}吨 | 冲次: ${pressResult.spm} SPM | 单件耗时: ${pressResult.cycleSec.toFixed(1)}秒`;
        
        let costItems = [
            { name: '材料费', val: materialCost }, { name: '冲压加工', val: pressResult.cost }, { name: '模具分摊', val: dieResult.perPart },
            { name: '焊接费', val: totalWeldCost }, { name: '检具费', val: gaugeCost }, { name: '表面处理', val: surfaceCost },
            { name: '物流费', val: logisticsCost }, { name: '管理费', val: managementCost }, { name: '利润', val: profit }
        ];
        let html = ''; costItems.forEach(i => { html += `<div class="cost-card"><span>${i.name}</span><span>${i.val.toFixed(2)} 元</span></div>`; });
        document.getElementById('costDetails').innerHTML = html;
        
        if (chartInstance) chartInstance.destroy();
        let ctx = document.getElementById('costChart').getContext('2d');
        chartInstance = new Chart(ctx, { type: 'pie', data: { labels: costItems.map(i=>i.name), datasets: [{ data: costItems.map(i=>i.val), backgroundColor: ['#3b82f6','#10b981','#f59e0b','#ef4444','#8b5cf6','#ec489a','#06b6d4','#f97316','#84cc16'] }] }, options: { responsive: true, maintainAspectRatio: true } });
        
        addToHistory();
    } catch(e) { console.error(e); alert("计算错误: " + e.message); }
}

function addToHistory() {
    let name = document.getElementById('partName').value;
    let total = parseFloat(document.getElementById('totalCostVal').innerText);
    let quote = parseFloat(document.getElementById('quotePriceVal').innerText);
    historyList.unshift({ id: Date.now(), partName: name, totalCost: total, quote: quote, time: new Date().toLocaleString() });
    if (historyList.length > 10) historyList.pop();
    saveHistory();
    renderHistoryList();
}

function renderHistoryList() {
    let container = document.getElementById('historyList');
    if (!container) return;
    if (historyList.length === 0) { container.innerHTML = '<div style="padding:20px;">暂无历史</div>'; return; }
    let html = '';
    historyList.slice(0, 5).forEach(h => { html += `<div class="history-item"><div><strong>${escapeHtml(h.partName)}</strong> ${h.totalCost.toFixed(2)}元</div><div class="time">${h.time}</div></div>`; });
    container.innerHTML = html;
}

function clearHistory() { if (confirm('清空历史？')) { historyList = []; saveHistory(); renderHistoryList(); showToast('已清空'); } }
function showToast(msg) { let t = document.createElement('div'); t.className = 'toast'; t.textContent = msg; document.body.appendChild(t); setTimeout(()=>t.remove(), 3000); }
function escapeHtml(s) { if(!s) return ''; return s.replace(/[&<>]/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;'})[m]); }

// ==================== 联动函数 ====================
function updateWeightMethod() {
    let method = document.getElementById('weightMethod').value;
    document.getElementById('netWeightGroup').style.display = method === 'netWeight' ? 'block' : 'none';
    document.getElementById('blankAreaGroup').style.display = method === 'blankArea' ? 'block' : 'none';
    document.getElementById('bomModeIndicator').style.display = method === 'bom' ? 'block' : 'none';
    calculate();
}
function updatePayment() { document.getElementById('partialRatioGroup').style.display = document.getElementById('diePayment').value === 'partial' ? 'block' : 'none'; calculate(); }
function updatePressTonnage() { document.getElementById('customTonnageGroup').style.display = document.getElementById('pressTonnage').value === 'custom' ? 'block' : 'none'; calculate(); }
function updateWeldType() {
    let type = document.getElementById('weldType').value;
    let isSpot = type === 'spot' || type === 'projection';
    let isArc = type === 'mig' || type === 'tig' || type === 'laser';
    let isRobot = type === 'robot';
    document.getElementById('spotCountGroup').style.display = isSpot ? 'block' : 'none';
    document.getElementById('weldLengthGroup').style.display = isArc ? 'block' : 'none';
    document.getElementById('robotTimeGroup').style.display = isRobot ? 'block' : 'none';
    document.getElementById('weldRate').value = getWeldRate(type);
    document.getElementById('weldRateUnit').innerText = getWeldUnit(type);
    calculate();
}
function updateGauge() { document.getElementById('gaugeConfig').style.display = document.getElementById('needGauge').value === 'yes' ? 'block' : 'none'; calculate(); }
function updateGaugeType() { document.getElementById('customGaugeGroup').style.display = document.getElementById('gaugeType').value === 'custom' ? 'block' : 'none'; calculate(); }
function updateSurface() { document.getElementById('surfacePriceGroup').style.display = document.getElementById('surfaceProcess').value !== 'none' ? 'block' : 'none'; calculate(); }

// ==================== 模态框 ====================
function renderMaterialModal() {
    let tbody = document.getElementById('materialTableBody');
    tbody.innerHTML = '';
    stampingMaterialsData.forEach((m, idx) => {
        let row = tbody.insertRow();
        row.insertCell(0).innerHTML = `<input value="${m.MaterialCode}" class="mat-code-${idx}">`;
        row.insertCell(1).innerHTML = `<input value="${m.Type}" class="mat-type-${idx}">`;
        row.insertCell(2).innerHTML = `<input value="${m.Spec}" class="mat-spec-${idx}">`;
        row.insertCell(3).innerHTML = `<input type="number" value="${m.UnitPrice}" class="mat-price-${idx}">`;
        row.insertCell(4).innerHTML = `<span class="edit-icon" data-idx="${idx}">💾</span> <span class="delete-icon" data-idx="${idx}">🗑️</span>`;
    });
    document.querySelectorAll('#materialTableBody .edit-icon').forEach(el => { el.onclick = () => { let idx = el.dataset.idx; stampingMaterialsData[idx].MaterialCode = document.querySelector(`.mat-code-${idx}`).value; stampingMaterialsData[idx].Type = document.querySelector(`.mat-type-${idx}`).value; stampingMaterialsData[idx].Spec = document.querySelector(`.mat-spec-${idx}`).value; stampingMaterialsData[idx].UnitPrice = parseFloat(document.querySelector(`.mat-price-${idx}`).value); saveMaterials(); refreshSelects(); renderMaterialModal(); calculate(); showToast('已保存'); }; });
    document.querySelectorAll('#materialTableBody .delete-icon').forEach(el => { el.onclick = () => { if(confirm('删除？')) { stampingMaterialsData.splice(el.dataset.idx,1); if(stampingMaterialsData.length===0) stampingMaterialsData.push({id:'d1',MaterialCode:'Q235A',Type:'热轧',Spec:'3.0mm',Thickness:3.0,Density:7.85,UnitPrice:3.5}); saveMaterials(); refreshSelects(); renderMaterialModal(); calculate(); } }; });
}
function renderWeldModal() {
    let tbody = document.getElementById('weldTableBody');
    tbody.innerHTML = '';
    weldPriceData.forEach((w, idx) => {
        let row = tbody.insertRow();
        row.insertCell(0).innerHTML = `<input value="${w.DisplayName}" class="weld-name-${idx}">`;
        row.insertCell(1).innerHTML = `<input value="${w.Unit}" class="weld-unit-${idx}">`;
        row.insertCell(2).innerHTML = `<input type="number" value="${w.DefaultPrice}" class="weld-price-${idx}">`;
        row.insertCell(3).innerHTML = `<span class="edit-icon" data-idx="${idx}">💾</span> <span class="delete-icon" data-idx="${idx}">🗑️</span>`;
    });
    document.querySelectorAll('#weldTableBody .edit-icon').forEach(el => { el.onclick = () => { let idx = el.dataset.idx; weldPriceData[idx].DisplayName = document.querySelector(`.weld-name-${idx}`).value; weldPriceData[idx].Unit = document.querySelector(`.weld-unit-${idx}`).value; weldPriceData[idx].DefaultPrice = parseFloat(document.querySelector(`.weld-price-${idx}`).value); saveWeldData(); refreshPreviewTables(); calculate(); showToast('已保存'); }; });
    document.querySelectorAll('#weldTableBody .delete-icon').forEach(el => { el.onclick = () => { if(confirm('删除？')) { weldPriceData.splice(el.dataset.idx,1); if(weldPriceData.length===0) weldPriceData.push({id:'w1',WeldType:'spot',DisplayName:'点焊',Unit:'元/点',DefaultPrice:0.25}); saveWeldData(); refreshPreviewTables(); calculate(); } }; });
}
function renderFeedbackList() {
    let container = document.getElementById('feedbackList');
    if(!container) return;
    if(feedbackList.length===0) { container.innerHTML='<div>暂无反馈</div>'; return; }
    let html='';
    feedbackList.forEach(f=>{ html+=`<div><strong>${f.type}</strong> ${escapeHtml(f.content)}<br><small>${f.time}</small></div><hr>`; });
    container.innerHTML=html;
}

// ==================== 事件绑定 ====================
function bindEvents() {
    document.getElementById('calcBtn').onclick = calculate;
    document.getElementById('resetBtn').onclick = () => { if(confirm('重置所有数据？')){ localStorage.clear(); location.reload(); } };
    document.getElementById('exportExcelBtn').onclick = () => alert('导出功能开发中');
    document.getElementById('weightMethod').onchange = updateWeightMethod;
    document.getElementById('diePayment').onchange = updatePayment;
    document.getElementById('pressTonnage').onchange = updatePressTonnage;
    document.getElementById('weldType').onchange = updateWeldType;
    document.getElementById('needGauge').onchange = updateGauge;
    document.getElementById('gaugeType').onchange = updateGaugeType;
    document.getElementById('surfaceProcess').onchange = updateSurface;
    document.getElementById('clearHistoryBtn').onclick = clearHistory;
    document.getElementById('scrapPricePreset').onchange = function() { document.getElementById('scrapPrice').value = this.value; calculate(); };
    let ids = ['annualQty','length','width','materialSelect','materialPrice','scrapRate','blankArea','materialUtilization','partNetWeight','dieType','dieLife','processCount','dieComplexity','partialRatio','strokePerMinute','equipmentRate','laborRate','changeoverTime','batchSize','weldSpotCount','weldLength','robotWeldTime','weldFixtureCost','surfacePrice','surfaceArea','logisticsDistance','ratePerTonKm','minFreight','fullLoadQty','handlingFee','scrapPrice','customPressTonnage','customGaugePrice','gaugeLife'];
    ids.forEach(id => { let el = document.getElementById(id); if(el) { el.addEventListener('input', calculate); if(el.tagName==='SELECT') el.addEventListener('change', calculate); } });
    document.getElementById('openMaterialModalBtn').onclick = () => { renderMaterialModal(); document.getElementById('materialModal').style.display='flex'; };
    document.getElementById('closeMaterialModal').onclick = () => document.getElementById('materialModal').style.display='none';
    document.getElementById('addMaterialBtn').onclick = () => { let code=document.getElementById('newMatCode').value, type=document.getElementById('newMatType').value, spec=document.getElementById('newMatSpec').value, price=parseFloat(document.getElementById('newMatPrice').value); if(code && spec && !isNaN(price)){ stampingMaterialsData.push({id:Date.now().toString(),MaterialCode:code,Type:type,Spec:spec,Thickness:1.0,Density:7.85,UnitPrice:price}); saveMaterials(); refreshSelects(); renderMaterialModal(); calculate(); showToast('已添加'); } else alert('请完整填写'); };
    document.getElementById('openWeldModalBtn').onclick = () => { renderWeldModal(); document.getElementById('weldModal').style.display='flex'; };
    document.getElementById('closeWeldModal').onclick = () => document.getElementById('weldModal').style.display='none';
    document.getElementById('addWeldRateBtn').onclick = () => { let type=document.getElementById('newWeldTypeSelect').value, price=parseFloat(document.getElementById('newWeldRate').value), unit=document.getElementById('newWeldUnit').value; let name={spot:'点焊',mig:'二保焊',tig:'氩弧焊',laser:'激光焊',projection:'凸焊',robot:'机器人焊接'}[type]; if(!isNaN(price) && unit){ weldPriceData.push({id:Date.now().toString(),WeldType:type,DisplayName:name,Unit:unit,DefaultPrice:price}); saveWeldData(); refreshPreviewTables(); calculate(); showToast('已添加'); } else alert('请完整填写'); };
    document.getElementById('addBomRowBtn').onclick = () => {
        let name = document.getElementById('newPartName').value.trim();
        let qty = parseInt(document.getElementById('newPartQty').value) || 1;
        let material = document.getElementById('newPartMaterial').value;
        let thickness = parseFloat(document.getElementById('newPartThickness').value);
        let length = parseFloat(document.getElementById('newPartLength').value);
        let width = parseFloat(document.getElementById('newPartWidth').value);
        if (!name) { alert('请填写零件名称'); return; }
        if (isNaN(thickness) || thickness <= 0) { alert('请填写有效厚度'); return; }
        if (isNaN(length) || length <= 0) { alert('请填写有效长度'); return; }
        if (isNaN(width) || width <= 0) { alert('请填写有效宽度'); return; }
        if (!material && stampingMaterialsData.length > 0) { material = stampingMaterialsData[0].MaterialCode; }
        bomItems.push({ id: Date.now().toString(), partName: name, qty: qty, materialCode: material, thickness: thickness, length: length, width: width, utilization: 75 });
        saveBomData(); renderBomTable(); calculate(); showToast(`已添加 ${name}`);
        document.getElementById('newPartName').value = '';
        document.getElementById('newPartQty').value = '1';
        document.getElementById('newPartThickness').value = '';
        document.getElementById('newPartLength').value = '';
        document.getElementById('newPartWidth').value = '';
    };
    document.getElementById('clearBomBtn').onclick = () => { if(confirm('清空BOM表？')){ bomItems=[]; saveBomData(); renderBomTable(); calculate(); showToast('已清空'); } };
    document.getElementById('feedbackBtn').onclick = () => document.getElementById('feedbackModal').style.display='flex';
    document.getElementById('viewFeedbackBtn').onclick = () => { renderFeedbackList(); document.getElementById('viewFeedbackModal').style.display='flex'; };
    document.getElementById('closeFeedbackModal').onclick = () => document.getElementById('feedbackModal').style.display='none';
    document.getElementById('closeViewModal').onclick = () => document.getElementById('viewFeedbackModal').style.display='none';
    document.getElementById('cancelFeedbackBtn').onclick = () => document.getElementById('feedbackModal').style.display='none';
    document.getElementById('submitFeedbackBtn').onclick = () => { let type=document.getElementById('feedbackType').value, content=document.getElementById('feedbackContent').value.trim(), contact=document.getElementById('feedbackContact').value; if(!content){ alert('请填写内容'); return; } feedbackList.unshift({id:Date.now(),type:type,content:content,contact:contact,time:new Date().toLocaleString()}); saveFeedback(); renderFeedbackList(); document.getElementById('feedbackModal').style.display='none'; document.getElementById('feedbackContent').value=''; showToast('感谢反馈！'); };
    document.getElementById('exportFeedbackBtn').onclick = () => { if(feedbackList.length===0){ alert('暂无反馈'); return; } let csv=[['ID','类型','内容','联系方式','时间']]; feedbackList.forEach(f=>csv.push([f.id,f.type,f.content,f.contact||'',f.time])); let blob=new Blob([csv.map(r=>r.map(c=>`"${String(c).replace(/"/g,'""')}"`).join(',')).join('\n')],{type:'text/csv'}); let a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=`feedback_${Date.now()}.csv`; a.click(); };
    document.getElementById('clearAllFeedbackBtn').onclick = () => { if(confirm('清空所有反馈？')){ feedbackList=[]; saveFeedback(); renderFeedbackList(); showToast('已清空'); } };
    window.onclick = (e) => { if(e.target===document.getElementById('materialModal')) document.getElementById('materialModal').style.display='none'; if(e.target===document.getElementById('weldModal')) document.getElementById('weldModal').style.display='none'; if(e.target===document.getElementById('feedbackModal')) document.getElementById('feedbackModal').style.display='none'; if(e.target===document.getElementById('viewFeedbackModal')) document.getElementById('viewFeedbackModal').style.display='none'; };
}

function initCollapse() {
    document.getElementById('bomHeader')?.addEventListener('click',()=>document.getElementById('bomContent')?.classList.toggle('show'));
    document.getElementById('weldHeader')?.addEventListener('click',()=>document.getElementById('weldContent')?.classList.toggle('show'));
    document.getElementById('gaugeHeader')?.addEventListener('click',()=>document.getElementById('gaugeContent')?.classList.toggle('show'));
    document.getElementById('collapseHeader')?.addEventListener('click',()=>document.getElementById('collapseContent')?.classList.toggle('show'));
    document.getElementById('historyHeader')?.addEventListener('click',()=>document.getElementById('historyContent')?.classList.toggle('show'));
}

// ==================== 初始化 ====================
function init() {
    loadFromStorage();
    refreshSelects();
    refreshPreviewTables();
    renderBomTable();
    renderHistoryList();
    bindEvents();
    updateWeightMethod();
    updatePayment();
    updatePressTonnage();
    updateWeldType();
    updateGauge();
    updateGaugeType();
    updateSurface();
    initCollapse();
    calculate();
    showToast('冲压件成本模型 V2.0 已加载');
}

init();
</script>
